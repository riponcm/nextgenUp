{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NextGenUp",
  "version": "1.0.0",
  "identifier": "com.riponcm.nextgenup",
  "build": {
    "frontendDist": "../desktop-ui"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwM0Q1RDAxNzg3RjlBMkIKUldRcm1uOTRBVjA5OEFFNHhRV3hkamhPdUhLdDJyeEF5bVNJWFJIeUxPTDU0T1VoYVQyaDhOZ2YK",
